# PostgreSQL, used by Prisma on the server only (never sent to the browser).

# App runtime. Supabase: transaction-mode pooler (IPv4), port 6543.
DATABASE_URL="postgresql://postgres.cefjrmmnngkvnihbvvta:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations (npm run db:migrate). Supabase: session-mode pooler, port 5432.
# For a plain local/VPS Postgres, leave this out and DATABASE_URL is used for both.
DIRECT_URL="postgresql://postgres.cefjrmmnngkvnihbvvta:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
